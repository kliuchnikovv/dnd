# Клиентские переменные окружения. Скопируй в .env и подставь свои значения.
# EXPO_PUBLIC_* вшиваются в JS-бандл на этапе сборки — после правки перезапусти
# Metro с очисткой кэша (npx expo start -c) или пересобери (npx expo run:ios --device).

# Адрес сервера. Из него выводится и WS-URL (http→ws, https→wss, +/chat/ws).
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client id'ы (Google Cloud Console → Credentials).
# iOS: клиент типа iOS, Bundle ID = com.kliuchnikovv.client.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com
# Web: клиент типа Web application (нужен как audience для бэкенда).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
# Android (опционально, когда будешь собирать под Android).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Напоминание по iOS: в app.json → ios.infoPlist.CFBundleURLTypes подставь
# ПЕРЕВЁРНУТЫЙ iOS client id (com.googleusercontent.apps.<id-задом-наперёд>) и
# пересобери — без этой URL-схемы OAuth-редирект не вернётся в приложение.
#
# Сервер (Railway env), НЕ здесь: GOOGLE_CLIENT_ID принимает несколько id через
# запятую — укажи И iOS, И web client id:
#   GOOGLE_CLIENT_ID=<ios>.apps.googleusercontent.com,<web>.apps.googleusercontent.com
