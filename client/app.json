{
  "expo": {
    "name": "client",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "dnd-client",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kliuchnikovv.client"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.41461252724-ffbeded5fihqjpb6im7nchpoggcuq064"
        }
      ]
    ],
    "extra": {
      "googleAuth": {
        "note": "Client id'ы читаются из EXPO_PUBLIC_GOOGLE_*_CLIENT_ID (.env, см. .env.example) — не отсюда. iOS URL-схему (перевёрнутый iOS client id) добавляет config-plugin @react-native-google-signin/google-signin через iosUrlScheme выше; для 123-abc.apps.googleusercontent.com это com.googleusercontent.apps.123-abc. После правки нужен нативный rebuild: npx expo prebuild -p ios --clean && npx expo run:ios --device."
      }
    }
  }
}
